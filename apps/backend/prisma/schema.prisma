generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  FUNCIONARIO
  ADMIN
}

enum CategoriaServico {
  BANHO_TOSA
  CONSULTA
}

enum StatusAgendamento {
  AGENDADO
  CONCLUIDO
  CANCELADO
  NAO_COMPARECEU
}

enum Porte {
  PEQUENO
  MEDIO
  GRANDE
}

enum TipoPlano {
  BASICO
  PADRAO
  PREMIUM
}

enum EstadoBeneficio {
  DISPONIVEL
  RESERVADO
  CONSUMIDO
  REVOGADO
}

enum TipoMovimentoFidelidade {
  IMPORTACAO
  CONTAGEM
  EMISSAO
  RESERVA
  LIBERACAO
  CONSUMO
  AJUSTE
}

model Fidelidade {
  id             Int      @id @default(autoincrement())
  beneficioAtivo Boolean
  qntdServicos   Int
  progresso      Int @default(0)
  beneficios     BeneficioFidelidade[]
  movimentos     MovimentoFidelidade[]
  usuario        Usuario?

  @@map("fidelidades")
}

model Usuario {
  id           Int           @id @default(autoincrement())
  email        String?       @unique
  telefone     String?
  funcionarioId Int? @unique @map("id_funcionario")
  funcionario Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  senhaHash    String        @map("senha_hash")
  role         Role
  cpf          String        @unique
  nome         String
  fidelidadeId Int           @unique @map("id_fidelidade")
  fidelidade   Fidelidade    @relation(fields: [fidelidadeId], references: [id], onDelete: Restrict)
  enderecos    Endereco[]
  animais      Animal[]
  assinaturas  Assinatura[]
  agendamentos Agendamento[]
  eventosAgenda EventoAgendamento[]
  movimentosFidelidade MovimentoFidelidade[]

  @@map("usuarios")
}

model Endereco {
  id          Int     @id @default(autoincrement())
  cep         String
  complemento String?
  bairro      String
  numero      Int
  rua         String
  usuarioId   Int     @map("id_usuario")
  usuario     Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model Animal {
  id           Int           @id @default(autoincrement())
  idade        Int
  porte        Porte
  especie      String
  raca         String?
  nome         String
  usuarioId    Int           @map("id_usuario")
  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  agendamentos Agendamento[]

  @@map("animais")
}

model Plano {
  id          Int          @id @default(autoincrement())
  preco       Decimal      @db.Decimal(10, 2)
  tipo        TipoPlano
  assinaturas Assinatura[]

  @@map("planos")
}

model Assinatura {
  id            Int      @id @default(autoincrement())
  servicosRest  Json?
  dataAquisicao DateTime @db.Date
  usuarioId     Int      @map("id_usuario")
  planoId       Int      @map("id_plano")
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  plano         Plano    @relation(fields: [planoId], references: [id], onDelete: Restrict)

  @@map("assinaturas")
}

model Servico {
  elegivelFidelidade Boolean @default(false)
  categoria CategoriaServico?
  ativo Boolean @default(false)
  profissionais Funcionario[] @relation("Habilitacao")
  id           Int           @id @default(autoincrement())
  descricao    String?
  duracaoMin   Int
  preco        Decimal       @db.Decimal(10, 2)
  nome         String
  agendamentos Agendamento[]

  @@map("servicos")
}

model Funcionario {
  ativo Boolean @default(false)
  servicos Servico[] @relation("Habilitacao")
  bloqueios BloqueioAgenda[]
  usuario Usuario?
  id           Int           @id @default(autoincrement())
  nome         String
  cargo        String
  telefone     String?
  agendamentos Agendamento[]

  @@map("funcionarios")
}

model Agendamento {
  elegivelFidelidade Boolean @default(false)
  precoBase Decimal? @db.Decimal(10, 2)
  desconto Decimal @default(0) @db.Decimal(10, 2)
  beneficioId Int?
  beneficio BeneficioFidelidade? @relation("ContratoBeneficio", fields: [beneficioId], references: [id], onDelete: Restrict)
  usoBeneficio BeneficioFidelidade? @relation("UsoBeneficio")
  beneficioGerado BeneficioFidelidade? @relation("GeracaoBeneficio")
  movimentosFidelidade MovimentoFidelidade[] @relation("MovimentosAgendamento")
  contagemFidelidade MovimentoFidelidade? @relation("ContagemAgendamento")
  status StatusAgendamento @default(AGENDADO)
  observacoes String? @db.VarChar(300)
  precoContratado Decimal? @db.Decimal(10, 2)
  duracaoContratadaMin Float
  eventos EventoAgendamento[]
  id            Int         @id @default(autoincrement())
  dataHoraIni   DateTime
  dataHoraFim   DateTime
  usuarioId     Int         @map("id_usuario")
  animalId      Int         @map("id_animal")
  servicoId     Int         @map("id_servico")
  funcionarioId Int         @map("id_funcionario")
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  animal        Animal      @relation(fields: [animalId], references: [id], onDelete: Restrict)
  servico       Servico     @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)

  @@map("agendamentos")
}

model ConfiguracaoAgenda {
  id Int @id @default(1)
  fuso String
  intervaloSlotMin Int
  antecedenciaCriacaoHoras Int
  antecedenciaCancelamentoHoras Int
  antecedenciaReagendamentoHoras Int
  intervalos Json

  @@map("configuracao_agenda")
}

model BloqueioAgenda {
  id Int @id @default(autoincrement())
  inicio DateTime
  fim DateTime
  motivo String? @db.VarChar(300)
  funcionarioId Int?
  funcionario Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)

  @@index([inicio, fim])
  @@map("bloqueios_agenda")
}

model EventoAgendamento {
  id Int @id @default(autoincrement())
  agendamentoId Int
  agendamento Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Restrict)
  autorId Int
  autor Usuario @relation(fields: [autorId], references: [id], onDelete: Restrict)
  instante DateTime @default(now())
  acao String
  motivo String? @db.VarChar(300)
  antes Json?
  depois Json

  @@index([agendamentoId, instante])
  @@map("eventos_agendamento")
}

model BeneficioFidelidade {
  id Int @id @default(autoincrement())
  fidelidadeId Int
  fidelidade Fidelidade @relation(fields: [fidelidadeId], references: [id], onDelete: Restrict)
  estado EstadoBeneficio @default(DISPONIVEL)
  criadoEm DateTime @default(now())
  geradorId Int? @unique
  gerador Agendamento? @relation("GeracaoBeneficio", fields: [geradorId], references: [id], onDelete: Restrict)
  agendamentoId Int? @unique
  agendamento Agendamento? @relation("UsoBeneficio", fields: [agendamentoId], references: [id], onDelete: Restrict)
  contratos Agendamento[] @relation("ContratoBeneficio")
  movimentos MovimentoFidelidade[]

  @@index([fidelidadeId, estado, criadoEm, id])
  @@map("beneficios_fidelidade")
}

model MovimentoFidelidade {
  id Int @id @default(autoincrement())
  fidelidadeId Int
  fidelidade Fidelidade @relation(fields: [fidelidadeId], references: [id], onDelete: Restrict)
  tipo TipoMovimentoFidelidade
  instante DateTime @default(now())
  autorId Int?
  autor Usuario? @relation(fields: [autorId], references: [id], onDelete: Restrict)
  motivo String? @db.VarChar(300)
  antes Json
  depois Json
  beneficioId Int?
  beneficio BeneficioFidelidade? @relation(fields: [beneficioId], references: [id], onDelete: Restrict)
  agendamentoId Int?
  agendamento Agendamento? @relation("MovimentosAgendamento", fields: [agendamentoId], references: [id], onDelete: Restrict)
  contagemAgendamentoId Int? @unique
  contagemAgendamento Agendamento? @relation("ContagemAgendamento", fields: [contagemAgendamentoId], references: [id], onDelete: Restrict)

  @@index([fidelidadeId, instante, id])
  @@map("movimentos_fidelidade")
}
