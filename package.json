{
  "name": "petshop",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "prisma:generate": "pnpm --filter @petshop/backend prisma:generate",
    "prisma:migrate": "pnpm --filter @petshop/backend prisma:migrate"
  },
  "devDependencies": {
    "@petshop/eslint-config": "workspace:*",
    "eslint": "^9.28.0",
    "turbo": "^2.5.4",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma"]
  }
}
